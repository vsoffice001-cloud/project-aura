        "muted":     { "$value": "rgba(250,250,250,0.40)",    "$type": "color", "$description": "Muted / disabled text on dark surface" }
      },
      "accent": {
        "primary":   { "$value": "#b01f24", "$type": "color", "$description": "Ken red CTA — same as brand.red, dark-surface use" },
