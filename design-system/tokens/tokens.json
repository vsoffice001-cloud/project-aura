      "cinematic-2":      { "$value": "#111113", "$type": "color" }
    },
    "scrim": {
      "$value": "rgba(0, 0, 0, 0.50)", "$type": "color", "$description": "Modal / sheet backdrop overlay"
    },
    "brand-red-alpha": {
      "$description": "Brand red w/ alpha — for chip borders, faint accents, image-overlay badge wrapper bg.",
      "30": { "$value": "rgba(176, 31, 36, 0.30)", "$type": "color" },
      "12": { "$value": "rgba(176, 31, 36, 0.12)", "$type": "color" },
      "65": { "$value": "rgba(176, 31, 36, 0.65)", "$type": "color", "$description": "Image-overlay 'Featured' badge bg (WCAG AAA over images)" },
      "80": { "$value": "rgba(176, 31, 36, 0.80)", "$type": "color", "$description": "Image-overlay 'Featured' badge border" }
    },
    "section-bg": {
      "$description": "Semantic section background tokens. Consumed by <SectionBg> pattern component. Editorial-light defaults; cinematic-dark variant overrides at @layer recipe-overrides. Added 2026-05-08 (Phase B3 step 2).",
      "primary":  { "$value": "#ffffff", "$type": "color", "$description": "Primary section background — default white, most sections" },
      "accent":   { "$value": "#f5f2f1", "$type": "color", "$description": "Accent section background — warm-300, alternation breaks" },
      "contrast": { "$value": "#000000", "$type": "color", "$description": "Contrast section background — black, hero/resources/dark testimonials" },
      "mesh":     { "$value": "transparent", "$type": "color", "$description": "Mesh-rendered section bg — transparent (DarkGradientMesh component supplies bg)" }
    },
    "status": {
      "$description": "Semantic status tokens — Badge themes (success/warning/error/info). Added 2026-05-08 (Phase C step 2b — Badge port). 92-5-3 hierarchy: status colors live outside the 5% brand budget; reserved for system/transactional UI.",
