  "composition": {
    "$description": "Composed gradient + pattern tokens. Consumed by <DarkGradientMesh>, <SectionBg>, <CarouselFadeMask> pattern components. Added 2026-05-08 (Phase B3 step 2 + B2 patterns deep-map).",
    "gradient": {
      "cinematic": {
        "$description": "5-overlay cinematic dark gradient mesh signature. Stack via mix-blend-mode:screen. See PATTERNS.md §5.",
        "base":            { "$value": "linear-gradient(180deg, #0f0f0f 0%, #1a1a1a 50%, #0f0f0f 100%)", "$type": "color", "$description": "Vertical vignette base for cinematic-dark sections" },
        "overlay-tl":      { "$value": "radial-gradient(circle at top left, rgba(76,95,215,0.15) 0%, rgba(76,95,215,0.075) 30%, transparent 60%)", "$type": "color", "$description": "Top-left purple overlay, blur 80px, screen blend" },
        "overlay-tr":      { "$value": "radial-gradient(circle at top right, rgba(124,58,237,0.18) 0%, rgba(124,58,237,0.09) 30%, transparent 60%)", "$type": "color", "$description": "Top-right violet overlay, blur 90px, screen blend" },
        "overlay-bl":      { "$value": "radial-gradient(circle at bottom left, rgba(5,150,105,0.14) 0%, rgba(5,150,105,0.07) 30%, transparent 60%)", "$type": "color", "$description": "Bottom-left green overlay, blur 75px, screen blend" },
        "overlay-br":      { "$value": "radial-gradient(circle at bottom right, rgba(194,65,12,0.16) 0%, rgba(194,65,12,0.08) 30%, transparent 60%)", "$type": "color", "$description": "Bottom-right orange overlay, blur 85px, screen blend" },
        "overlay-center":  { "$value": "radial-gradient(circle at center, rgba(255,255,255,0.02) 0%, transparent 60%)", "$type": "color", "$description": "Center white diffusion, blur 60px" }
      },
      "editorial": {
        "warm-vignette": { "$value": "linear-gradient(180deg, #faf9f8 0%, #f5f2f1 40%, #faf9f8 100%)", "$type": "color", "$description": "Editorial warm sweep — promoted from --bg-composition-warm-editorial (was theme.css orphan)" }
      },
      "brand": {
        "red-cta":   { "$value": "linear-gradient(90deg, #b01f24 0%, #c62d31 100%)", "$type": "color", "$description": "Ken red CTA gradient — primary button base" },
        "red-shimmer": { "$value": "linear-gradient(90deg, #b01f24 0%, #eb484e 50%, #b01f24 100%)", "$type": "color", "$description": "Animated CTA shimmer — useShimmer hook drives" },
        "dark-shimmer": { "$value": "linear-gradient(90deg, #141016 0%, #656565 50%, #141016 100%)", "$type": "color", "$description": "Dark surface shimmer — secondary button base" }
      },
      "navbar": {
        "hover-glow-narrow": { "$value": "radial-gradient(ellipse 32.5px 15.5px at center, rgba(128,108,224,1) 0%, rgba(128,108,224,0) 100%)", "$type": "color", "$description": "Narrow nav-link hover bloom (purple)" },
        "hover-glow-wide":   { "$value": "radial-gradient(ellipse 72.78px 15.5px at center, rgba(128,108,224,1) 0%, rgba(128,108,224,0) 100%)", "$type": "color", "$description": "Wide nav-link hover bloom (purple)" }
      },
