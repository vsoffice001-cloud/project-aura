        "text":   { "$value": "#166534", "$type": "color" },
        "bg":     { "$value": "#f0fdf4", "$type": "color" },
        "border": { "$value": "#bbf7d0", "$type": "color" },
        "bg-hover":     { "$value": "#dcfce7", "$type": "color" },
        "border-hover": { "$value": "#86efac", "$type": "color" }
      },
      "warning": {
        "text":   { "$value": "#92400e", "$type": "color" },
        "bg":     { "$value": "#fffbeb", "$type": "color" },
        "border": { "$value": "#fde68a", "$type": "color" },
        "bg-hover":     { "$value": "#fef3c7", "$type": "color" },
        "border-hover": { "$value": "#fcd34d", "$type": "color" }
      },
      "error": {
        "text":   { "$value": "#991b1b", "$type": "color" },
        "bg":     { "$value": "#fef2f2", "$type": "color" },
        "border": { "$value": "#fecaca", "$type": "color" },
        "bg-hover":     { "$value": "#fee2e2", "$type": "color" },
        "border-hover": { "$value": "#fca5a5", "$type": "color" }
