{
  "name": "@kenresearch/design-system",
  "version": "0.1.0",
  "description": "Ken Research Design System v2 — typed atoms, recipe-driven, token-only, editorial-light + cinematic-dark variants",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": "./src/index.ts",
    "./atoms": "./src/atoms/index.ts",
    "./molecules": "./src/molecules/index.ts",
    "./organisms": "./src/organisms/index.ts",
    "./patterns": "./src/patterns/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./charts": "./src/charts/index.ts",
    "./types": "./src/types/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/utilities.css": "./src/styles/utilities.css",
    "./styles/editorial-light.css": "./src/styles/editorial-light.css",
    "./styles/cinematic-dark.css": "./src/styles/cinematic-dark.css"
  },
  "_exports_note": "Workspace consumers (Next 15) consume TS source via `transpilePackages: ['@kenresearch/design-system']`. Pre-publish to npm: switch back to dist/* paths after running `pnpm build`.",
  "files": [
    "dist/",
    "src/styles/",
    "README.md",
    "CHANGES.md",
    "docs/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "playground": "vite serve playground",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src/",
    "lint:recipes": "node scripts/lint-section-alternation.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "bash ../../scripts/verify.sh"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@kenresearch/tokens": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12",
    "highcharts": "^11",
    "highcharts-react-official": "^3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^8.10.2",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^2.1.9",
    "react-responsive-masonry": "^2.1.7",
    "recharts": "^2.15.4",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1",
    "typescript": "^5.5",
    "vite": "^6"
  }
}
