{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "playground",
    "src/organisms/_consumer-coupled",
    "src/atoms/_consumer-coupled",
    "**/*.stories.*",
    "**/*.test.*"
  ]
}
