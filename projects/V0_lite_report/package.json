{
  "name": "@kenresearch/v0-lite-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "verify": "bash ../../scripts/verify.sh",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,md}'",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@kenresearch/design-system": "workspace:*",
    "@kenresearch/tokens": "workspace:*",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "framer-motion": "^12",
    "highcharts": "^11",
    "highcharts-react-official": "^3",
    "lucide-react": "^0.487",
    "@faker-js/faker": "^9",
    "clsx": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "typescript": "^5.5",
    "tailwindcss": "^4.1",
    "@tailwindcss/postcss": "^4.1",
    "postcss": "^8",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "prettier": "^3",
    "@playwright/test": "^1",
    "msw": "^2"
  }
}
